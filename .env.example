# ==============================================================================
# Stelify Music Player - Environment Configuration
# ==============================================================================

# Database Connection (SQLite Default)
DATABASE_URL="file:./dev.db"

# Google Gemini API Configuration (Default / Recommended)
GEMINI_API_KEY=""
GOOGLE_API_KEY=""
GEMINI_MAIN_MODEL="gemini-2.0-flash"
GEMINI_EXTRACT_MODEL="gemini-1.5-flash"

# Groq Cloud API Configuration (High-Speed Inference)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_TAGGING_MODEL="llama-3.1-8b-instant"

# OpenAI API Configuration (Optional)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# OpenRouter API Configuration (Optional Universal Gateway)
OPENROUTER_API_KEY=""

# AI Research & Web Extraction (Optional)
FIRECRAWL_API_KEY=""
AI_RESEARCH_PROVIDER="gemini"
